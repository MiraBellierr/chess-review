{
  "name": "chess-review",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm -w server run dev\" \"npm -w web run dev\"",
    "build": "npm -w web run build",
    "start": "npm -w server run start",
    "analyze": "npm -w server run cli --",
    "selfcheck": "npm -w server run selfcheck"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
